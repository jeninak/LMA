<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Notes.ViewModels"
             x:Class="Notes.Views.AboutPage"
             x:DataType="viewmodels:AboutViewModel"
             Title="About">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Label Text="{Binding Title}" Style="{StaticResource TitleLabelStyle}" />
            <Label Text="{Binding Version}" Style="{StaticResource SubtitleLabelStyle}" />

            <!-- Image / logo area -->
            <VerticalStackLayout HorizontalOptions="Center" Padding="0,8,0,0">
                <Frame CornerRadius="72"
               HeightRequest="144"
               WidthRequest="144"
               BackgroundColor="{StaticResource CardBackgroundColor}"
               HasShadow="True"
               Padding="6"
               HorizontalOptions="Center">
                    <!-- Replace 'about-logo.png' with your file name in Resources/Images -->
                    <Image Source="hardworking_cat.png"
                 Aspect="AspectFill"
                 HeightRequest="132"
                 WidthRequest="132"
                 HorizontalOptions="Center"
                 VerticalOptions="Center" />
                </Frame>
            </VerticalStackLayout>

            <Frame Style="{StaticResource CardFrameStyle}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="About" Style="{StaticResource SubtitleLabelStyle}" />
                    <Label Text="{Binding Message}" Style="{StaticResource BodyLabelStyle}" />
                </VerticalStackLayout>
            </Frame>

            <Frame Style="{StaticResource CardFrameStyle}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Joke of the day" Style="{StaticResource SubtitleLabelStyle}" />
                    <ActivityIndicator Color="{StaticResource PrimaryColor}" IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" />
                    <Label Text="{Binding JokeOfTheDay}" Style="{StaticResource BodyLabelStyle}" LineBreakMode="WordWrap" />
                    <HorizontalStackLayout Spacing="12">
                        <Button Text="Refresh" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding RefreshJokeCommand}" />
                        <Button Text="More info" BackgroundColor="Transparent" TextColor="{StaticResource PrimaryColor}" Command="{Binding ShowMoreInfoCommand}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>